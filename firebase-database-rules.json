{
  "rules": {
    "tournaments": {
      ".read": "auth != null && query.orderByChild === 'creator' && query.equalTo === auth.uid",
      ".indexOn": ["creator"],

      "$tournamentId": {
        ".read": true,
        ".write": "auth != null && (data.exists() ? data.child('creator').val() === auth.uid : newData.child('creator').val() === auth.uid)",
        ".validate": "newData.hasChildren(['players', 'matches', 'creator'])",

        "matches": {
          ".write": "data.parent().exists() && data.parent().child('locked').val() !== true",
          ".validate": "newData.hasChildren()",
          "$matchId": {
            ".validate": "newData.hasChildren()"
          }
        },

        "locked": {
          ".write": "data.parent().exists() && newData.val() === true",
          ".validate": "newData.isBoolean()"
        },

        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        },

        "players": {
          ".validate": "newData.hasChildren()"
        },

        "creator": {
          ".validate": "newData.isString()"
        }
      }
    }
  }
}
